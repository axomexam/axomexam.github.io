  <string name="ob1_title">Welcome to axomexam</string>
  <string name="ob1_body">Mock tests, previous year papers, e-books and bilingual notes for ADRE, APSC, Assam Police, SSC and Railway exams.</string>
  <string name="ob2_title">Everything you need</string>
  <string name="ob2_body">Built for serious aspirants. Completely free.</string>
  <string name="ob2_f1t">Timed Mock Tests</string>
  <string name="ob2_f1d">Real exam pattern with instant results and answer review.</string>
  <string name="ob2_f2t">Bilingual Q&amp;A</string>
  <string name="ob2_f2d">Every question and explanation in English and Assamese.</string>
  <string name="ob2_f3t">PYQs &amp; PDF Notes</string>
  <string name="ob2_f3d">Previous year papers and study notes for offline practice.</string>
  <string name="ob2_f4t">Made for Mobile</string>
  <string name="ob2_f4d">Fast, light and easy to use on any Android phone.</string>

  <string name="ob3_title">How to use axomexam</string>
  <string name="ob3_body">Six quick steps to get the most out of the app.</string>
  <string name="ob3_s1">Practice anytime — open Practice to read bilingual Q&amp;A with explanations.</string>
  <string name="ob3_s2">Take mock tests — pick a subject, set the timer and get an instant score.</string>
  <string name="ob3_s3">Read e-books — every subject e-book opens right inside the app.</string>
  <string name="ob3_s4">Download notes — save PDFs to your phone for offline study.</string>
  <string name="ob3_s5">Move around — use the bottom bar and the Menu for everything else.</string>
  <string name="ob3_s6">Refresh — pull the page down from the top to reload the latest content.</string>

  <string name="ob4_title">Terms &amp; Conditions</string>
  <string name="ob4_body">Please read and accept to continue.</string>
  <string name="ob4_t1"><b>1. Free for personal use.</b> axomexam is free for your own exam preparation. Content may not be copied, resold or redistributed.</string>
  <string name="ob4_t2"><b>2. Content accuracy.</b> We work hard to keep questions and notes correct, but errors are possible. Always verify details with official notifications.</string>
  <string name="ob4_t3"><b>3. No guarantee.</b> The app and its content are provided as is, without any warranty. Use of the app is at your own risk.</string>
  <string name="ob4_t4"><b>4. Privacy.</b> No registration is needed. Basic device data may be used only to improve the app experience.</string>
  <string name="ob4_t5"><b>5. Updates.</b> These terms may change from time to time. Continued use of the app means you accept the latest terms.</string>

  <string name="ob5_title">You are all set!</string>
