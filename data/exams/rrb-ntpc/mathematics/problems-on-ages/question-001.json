    "id": "problems-on-ages-001",
    "q": {
      "en": "A father is twice as old as his son. If the son is 15, the father's age is:",
      "as": "এজন পিতৃ তেওঁৰ পুত্ৰৰ দুগুণ বয়সীয়া। পুত্ৰ ১৫ বছৰীয়া হ'লে পিতৃৰ বয়স:"
    },
    "options": [
      {
        "en": "30 years",
        "as": "৩০ বছৰ"
      },
      {
        "en": "25 years",
        "as": "২৫ বছৰ"
      },
      {
        "en": "35 years",
        "as": "৩৫ বছৰ"
      },
      {
        "en": "45 years",
        "as": "৪৫ বছৰ"
      }
    ],
    "correct": 0,
    "explanation": {
      "en": "Father's age = 2 × 15 = 30 years.",
      "as": "পিতৃৰ বয়স = ২ × ১৫ = ৩০ বছৰ।"
    }
  }
]
