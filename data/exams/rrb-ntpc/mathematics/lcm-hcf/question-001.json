[
  {
    "id": "lcm-hcf-001",
    "q": {
      "en": "The LCM of 12 and 18 is:",
      "as": "১২ আৰু ১৮ ৰ ল.সা.গু. হ'ল:"
    },
    "options": [
      {
        "en": "72",
        "as": "৭২"
      },
      {
        "en": "36",
        "as": "৩৬"
      },
      {
        "en": "6",
        "as": "৬"
      },
      {
        "en": "216",
        "as": "২১৬"
      }
    ],
    "correct": 1,
    "explanation": {
      "en": "LCM = (12 × 18) ÷ HCF(6) = 36.",
      "as": "ল.সা.গু. = (১২ × ১৮) ÷ গ.সা.গু.(৬) = ৩৬।"
    }
