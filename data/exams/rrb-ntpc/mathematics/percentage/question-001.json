      {
        "en": "20%",
        "as": "২০%"
      },
      {
        "en": "25%",
        "as": "২৫%"
      },
      {
        "en": "30%",
        "as": "৩০%"
      },
      {
        "en": "15%",
        "as": "১৫%"
      }
