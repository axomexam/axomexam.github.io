        "en": "24",
        "as": "২৪"
      },
      {
        "en": "32",
        "as": "৩২"
      },
      {
        "en": "36",
        "as": "৩৬"
      },
      {
        "en": "72",
        "as": "৭২"
      }
    ],
    "correct": 2,
    "explanation": {
      "en": "12 = 2² × 3 and 18 = 2 × 3². LCM = 2² × 3² = 36.",
      "as": "১২ = ২² × ৩ আৰু ১৮ = ২ × ৩²। ল.সা.গু. = ২² × ৩² = ৩৬।"
    }
