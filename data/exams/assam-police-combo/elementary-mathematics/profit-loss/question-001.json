[
  {
    "id": "profit-loss-001",
    "q": {
      "en": "A shopkeeper buys an article for Rs 500 and sells it for Rs 575. Find the profit percentage.",
      "as": "এজন দোকানীয়ে ৫০০ টকাত এটা বস্তু কিনি ৫৭৫ টকাত বিক্ৰী কৰে। লাভৰ শতাংশ নিৰ্ণয় কৰা।"
    },
    "options": [
      {
        "en": "10%",
        "as": "১০%"
      },
      {
        "en": "15%",
        "as": "১৫%"
      },
      {
        "en": "20%",
        "as": "২০%"
      },
      {
        "en": "25%",
        "as": "২৫%"
      }
    ],
    "correct": 1,
    "explanation": {
      "en": "Profit = 575 - 500 = Rs 75. Profit % = (75 / 500) x 100 = 15%.",
      "as": "লাভ = ৫৭৫ - ৫০০ = ৭৫ টকা। লাভ % = (৭৫ / ৫০০) x ১০০ = ১৫%।"
    }
  }
]
