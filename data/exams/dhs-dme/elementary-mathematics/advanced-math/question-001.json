    "options": [
      {
        "en": "7",
        "as": "7"
      },
      {
        "en": "9",
        "as": "9"
      },
      {
        "en": "5",
        "as": "5"
      },
      {
        "en": "11",
        "as": "11"
      }
    ],
    "correct": 0,
    "explanation": {
      "en": "x² + 1/x² = (x + 1/x)² − 2 = 3² − 2 = 7.",
      "as": "x² + 1/x² = (x + 1/x)² − 2 = 3² − 2 = 7।"
