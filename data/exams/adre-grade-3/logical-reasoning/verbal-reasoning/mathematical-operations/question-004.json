    "q": {
      "en": "If ÷ means −, then 10 ÷ 4 = ?",
      "as": "যদি ÷ ৰ অৰ্থ − হয়, তেন্তে 10 ÷ 4 = ?"
    },
    "options": [
      {
        "en": "14",
        "as": "১৪"
      },
      {
        "en": "6",
        "as": "৬"
      },
      {
        "en": "40",
        "as": "৪০"
      },
      {
        "en": "2.5",
        "as": "২.৫"
      }
