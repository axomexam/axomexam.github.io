    "q": {
      "en": "If − means ÷, then 20 − 4 = ?",
      "as": "যদি − ৰ অৰ্থ ÷ হয়, তেন্তে 20 − 4 = ?"
    },
    "options": [
      {
        "en": "16",
        "as": "১৬"
      },
      {
        "en": "5",
        "as": "৫"
      },
      {
        "en": "24",
        "as": "২৪"
      },
      {
        "en": "80",
        "as": "৮০"
      }
    ],
    "correct": 1,
    "explanation": {
      "en": "With − meaning division, 20 − 4 becomes 20 ÷ 4 = 5.",
      "as": "− ৰ অৰ্থ হৰণ হ'লে 20 − 4 এ 20 ÷ 4 = 5 হয়।"
