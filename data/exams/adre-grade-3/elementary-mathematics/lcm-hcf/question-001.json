    "id": "lcm-hcf-001",
    "q": {
      "en": "The HCF of 36 and 48 is —",
      "as": "36 আৰু 48 ৰ গ.সা.উ. —"
    },
    "options": [
      {
        "en": "12",
        "as": "১২"
      },
      {
        "en": "18",
        "as": "১৮"
      },
      {
        "en": "24",
        "as": "২৪"
      },
      {
        "en": "6",
        "as": "৬"
      }
    ],
    "correct": 0,
    "explanation": {
      "en": "36 = 2^2 x 3^2 and 48 = 2^4 x 3, so HCF = 2^2 x 3 = 12.",
      "as": "36 = 2^2 x 3^2 আৰু 48 = 2^4 x 3, গতিকে গ.সা.উ. = 2^2 x 3 = 12।"
    }
