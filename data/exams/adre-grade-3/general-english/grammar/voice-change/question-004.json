    },
    "options": [
      {
        "en": "Rama killed Ravana.",
        "as": "Rama killed Ravana."
      },
      {
        "en": "Ravana was killed by Rama.",
        "as": "Ravana was killed by Rama."
      },
      {
        "en": "Rama is killing Ravana.",
        "as": "Rama is killing Ravana."
