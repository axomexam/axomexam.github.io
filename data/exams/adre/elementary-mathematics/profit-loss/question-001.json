{
  "id": "profit-loss-001",
  "q": {
    "en": "An article bought for ₹200 is sold for ₹250. What is the profit percentage?",
    "as": "200 টকাত কিনা এটা বস্তু 250 টকাত বিক্ৰী কৰা হ'ল। লাভৰ শতাংশ কিমান?"
  },
  "options": [
    {
      "en": "20%",
      "as": "২০%"
    },
    {
      "en": "25%",
      "as": "২৫%"
    },
    {
      "en": "50%",
      "as": "৫০%"
    },
    {
      "en": "10%",
      "as": "১০%"
    }
  ],
  "correct": 1,
  "explanation": {
    "en": "Profit = 250 − 200 = ₹50; Profit % = (50 / 200) × 100 = 25%.",
    "as": "লাভ = 250 − 200 = 50 টকা; লাভ % = (50 / 200) × 100 = 25%।"
  }
}
