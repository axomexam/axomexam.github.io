  "q": {
    "en": "What is the LCM of 12 and 18?",
    "as": "12 আৰু 18 ৰ ল.সা.গু. কিমান?"
  },
  "options": [
    {
      "en": "6",
      "as": "৬"
    },
    {
      "en": "36",
      "as": "৩৬"
    },
    {
      "en": "72",
      "as": "৭২"
    },
    {
      "en": "216",
      "as": "২১৬"
    }
  ],
  "correct": 1,
  "explanation": {
    "en": "12 = 2²×3 and 18 = 2×3², so LCM = 2²×3² = 36.",
    "as": "12 = 2²×3 আৰু 18 = 2×3², গতিকে ল.সা.গু. = 2²×3² = 36।"
  }
