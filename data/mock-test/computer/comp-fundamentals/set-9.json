  "questions": [
    {
      "q": {
        "en": "1 kilobyte (KB) is equal to?",
        "as": "১ কিল'বাইট (KB) কিমানৰ সমান?"
      },
      "options": [
        {
          "en": "1000 bytes",
          "as": "১০০০ বাইট"
        },
        {
          "en": "1024 bytes",
          "as": "১০২৪ বাইট"
        },
        {
          "en": "512 bytes",
          "as": "৫১২ বাইট"
        },
        {
          "en": "2048 bytes",
          "as": "২০৪৮ বাইট"
        }
      ],
      "correct": 1,
      "explanation": {
        "en": "In binary measurement, 1 KB = 2 to the power 10 bytes = 1024 bytes.",
        "as": "বাইনাৰি মাপত ১ KB = ২¹⁰ বাইট = ১০২৪ বাইট।"
      }
    }
  ]
}
