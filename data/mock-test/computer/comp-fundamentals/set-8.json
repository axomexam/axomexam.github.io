      "q": {
        "en": "Which of the following is an input device?",
        "as": "তলৰ কোনটো ইনপুট যন্ত্ৰ?"
      },
      "options": [
        {
          "en": "Monitor",
          "as": "মনিটৰ"
        },
        {
          "en": "Printer",
          "as": "প্ৰিণ্টাৰ"
        },
        {
          "en": "Keyboard",
          "as": "কীব'ৰ্ড"
        },
        {
          "en": "Speaker",
          "as": "স্পীকাৰ"
        }
      ],
      "correct": 2,
      "explanation": {
        "en": "A keyboard is used to enter data into a computer, so it is an input device.",
        "as": "কীব'ৰ্ডে কম্পিউটাৰত তথ্য সুমুৱাবলৈ ব্যৱহাৰ হয়; সেয়ে ই এটা ইনপুট যন্ত্ৰ।"
      }
    }
  ]
