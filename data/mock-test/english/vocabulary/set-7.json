  "setNumber": 7,
  "title": "Set 7",
  "subject": "English Vocabulary",
  "questions": [
    {
      "q": {
        "en": "Choose the antonym of 'expand':",
        "as": "'expand' ৰ বিপৰীত শব্দ বাছক:"
      },
      "options": [
        {
          "en": "spread",
          "as": "বিস্তাৰ কৰা"
        },
        {
          "en": "enlarge",
          "as": "ডাঙৰ কৰা"
        },
        {
          "en": "contract",
          "as": "সঙ্কুচিত কৰা"
        },
        {
          "en": "extend",
          "as": "প্ৰসাৰিত কৰা"
        }
      ],
      "correct": 2,
      "explanation": {
        "en": "'Expand' means to become larger, so its opposite is 'contract', meaning to become smaller.",
        "as": "'expand' ৰ অৰ্থ ডাঙৰ হোৱা; সেয়ে ইয়াৰ বিপৰীত 'contract', যাৰ অৰ্থ সৰু বা সঙ্কুচিত হোৱা।"
      }
    }
  ]
}
