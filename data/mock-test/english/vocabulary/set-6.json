  "questions": [
    {
      "q": {
        "en": "Choose the synonym of 'brave':",
        "as": "'brave' ৰ সমাৰ্থক শব্দ বাছক:"
      },
      "options": [
        {
          "en": "cowardly",
          "as": "ভয়াতুৰ"
        },
        {
          "en": "courageous",
          "as": "সাহসী"
        },
        {
          "en": "weak",
          "as": "দুৰ্বল"
        },
        {
          "en": "lazy",
          "as": "অলস"
        }
      ],
      "correct": 1,
      "explanation": {
        "en": "'Courageous' means showing courage, so it is a synonym of 'brave'.",
        "as": "'courageous' ৰ অৰ্থ সাহস দেখুওৱা; সেয়ে ই 'brave' ৰ সমাৰ্থক শব্দ।"
      }
    }
  ]
