        {
          "en": "in",
          "as": "ভিতৰত"
        },
        {
          "en": "at",
          "as": "ত"
        },
        {
          "en": "under",
          "as": "তলত"
        }
      ],
      "correct": 0,
      "explanation": {
        "en": "'On' is used to show that something is resting on a surface, so 'on the table' is correct.",
        "as": "কোনো বস্তু পৃষ্ঠৰ ওপৰত অৱস্থিত বুলি দেখুৱাবলৈ 'on' ব্যৱহাৰ হয়; সেয়ে 'on the table' শুদ্ধ।"
      }
    }
