{
  "setNumber": 7,
  "title": "Set 7",
  "subject": "English Grammar",
  "questions": [
    {
      "q": {
        "en": "He ___ to school every day.",
        "as": "তেওঁ প্ৰতিদিনে বিদ্যালয়লৈ ___।"
      },
      "options": [
        {
          "en": "go",
          "as": "go"
        },
        {
          "en": "goes",
          "as": "goes"
        },
        {
          "en": "going",
          "as": "going"
        },
        {
          "en": "gone",
          "as": "gone"
        }
      ],
      "correct": 1,
      "explanation": {
        "en": "In the simple present tense, a third-person singular subject takes the verb with 's', so 'goes' is correct.",
        "as": "সাধাৰণ বৰ্তমান কালত তৃতীয় পুৰুষ একবচন কৰ্তাৰ সৈতে ক্ৰিয়াৰ লগত 's' যোগ হয়; সেয়ে 'goes' শুদ্ধ।"
      }
    }
  ]
}
