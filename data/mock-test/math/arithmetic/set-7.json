{
  "setNumber": 7,
  "title": "Set 7",
  "subject": "Arithmetic",
  "questions": [
    {
      "q": {
        "en": "A man buys an article for Rs. 400 and sells it for Rs. 500. Find his profit percentage.",
        "as": "এজন মানুহে 400 টকাত এটা বস্তু কিনি 500 টকাত বিক্ৰী কৰে। তেওঁৰ লাভৰ শতকৰা হাৰ কিমান?"
      },
      "options": [
        {
          "en": "20%",
          "as": "20%"
        },
        {
          "en": "25%",
          "as": "25%"
        },
        {
          "en": "30%",
          "as": "30%"
        },
        {
          "en": "15%",
          "as": "15%"
        }
      ],
      "correct": 1,
      "explanation": {
        "en": "Profit = 500 − 400 = Rs. 100; profit % = (100/400) × 100 = 25%.",
        "as": "লাভ = 500 − 400 = 100 টকা; লাভৰ হাৰ = (100/400) × 100 = 25%।"
      }
    }
  ]
}
