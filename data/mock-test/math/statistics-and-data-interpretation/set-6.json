      "q": {
        "en": "The mean of 4, 8, 10, 14 and 24 is:",
        "as": "4, 8, 10, 14 আৰু 24 ৰ মধ্যমান (Mean) কিমান?"
      },
      "options": [
        {
          "en": "10",
          "as": "10"
        },
        {
          "en": "12",
          "as": "12"
        },
        {
          "en": "14",
          "as": "14"
        },
        {
          "en": "8",
          "as": "8"
        }
      ],
      "correct": 1,
      "explanation": {
        "en": "Mean = (4 + 8 + 10 + 14 + 24) / 5 = 60/5 = 12.",
        "as": "মধ্যমান = (4 + 8 + 10 + 14 + 24) / 5 = 60/5 = 12।"
      }
    }
  ]
