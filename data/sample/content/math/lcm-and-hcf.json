      "q": {
        "en": "Find the LCM of 12 and 18.",
        "as": "12 আৰু 18 ৰ ল.সা.গু. নিৰ্ণয় কৰা।"
      },
      "options": {
        "en": [
          "(a) 36",
          "(b) 24",
          "(c) 54",
          "(d) 18"
        ],
        "as": [
          "(ক) ৩৬",
          "(খ) ২৪",
          "(গ) ৫৪",
          "(ঘ) ১৮"
        ]
      },
      "correct": "a",
      "a": {
        "en": [
          "Rule: Prime factorize each number.",
          "Step 1: 12 = 2² × 3",
          "Step 2: 18 = 2 × 3²",
          "Step 3: Take highest powers: 2², 3²",
          "Step 4: LCM = 4 × 9 = 36",
          "Answer: (a) 36"
        ],
        "as": [
          "নিয়ম: প্ৰতিটো সংখ্যা মৌলিক উৎপাদকত বিশ্লেষণ।",
          "পদক্ষেপ ১: 12 = 2² × 3",
