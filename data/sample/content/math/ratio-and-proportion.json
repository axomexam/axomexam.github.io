      "q": {
        "en": "Simplify the ratio 12 : 18.",
        "as": "12 : 18 অনুপাত সৰল কৰা।"
      },
      "options": {
        "en": [
          "(a) 2 : 3",
          "(b) 3 : 2",
          "(c) 2 : 4",
          "(d) 3 : 4"
        ],
        "as": [
          "(ক) ২ : ৩",
          "(খ) ৩ : ২",
          "(গ) ২ : ৪",
          "(ঘ) ৩ : ৪"
        ]
      },
      "correct": "a",
      "a": {
        "en": [
          "Rule: Divide both terms by their HCF.",
          "Step 1: HCF of 12 and 18 = 6",
          "Step 2: 12 ÷ 6 = 2; 18 ÷ 6 = 3",
          "Step 3: Ratio = 2 : 3",
          "Answer: (a) 2 : 3"
        ],
        "as": [
          "নিয়ম: দুয়োটা পদক তেওঁলোকৰ গ.সা.গু.ৰে ভাগ।",
          "পদক্ষেপ ১: 12 আৰু 18 ৰ গ.সা.গু. = 6",
          "পদক্ষেপ ২: 12 ÷ 6 = 2; 18 ÷ 6 = 3",
          "পদক্ষেপ ৩: অনুপাত = 2 : 3",
          "উত্তৰ: (ক) 2 : 3"
        ]
      }
    },
