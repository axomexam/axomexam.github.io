    {
      "q": {
        "en": "Find 20% of 250.",
        "as": "250 ৰ 20% নিৰ্ণয় কৰা।"
      },
      "options": {
        "en": [
          "(a) 50",
          "(b) 25",
          "(c) 40",
          "(d) 60"
        ],
        "as": [
          "(ক) ৫০",
          "(খ) ২৫",
          "(গ) ৪০",
          "(ঘ) ৬০"
        ]
      },
      "correct": "a",
      "a": {
        "en": "(a) 50",
        "as": "(ক) 50"
      },
      "explanation": {
        "en": "Percent means 'per hundred', so 20% of 250 = 250 x 20/100. Quick trick: 10% of 250 is 25, so 20% is 2 x 25 = 50.",
        "as": "শতাংশৰ অৰ্থ 'শতিকৈ এভাগ'। গতিকে 250 ৰ 20% = 250 x 20/100। সহজ উপায়: 250 ৰ 10% = 25, সেয়ে 20% = 2 x 25 = 50।"
      }
    },
    {
      "q": {
        "en": "What percent is 36 of 180?",
        "as": "36, 180 ৰ কিমান শতাংশ?"
      },
      "options": {
        "en": [
          "(a) 30%",
          "(b) 20%",
          "(c) 25%",
          "(d) 18%"
        ],
        "as": [
          "(ক) ৩০%",
          "(খ) ২০%",
          "(গ) ২৫%",
          "(ঘ) ১৮%"
        ]
      },
      "correct": "b",
      "a": {
        "en": "(b) 20%",
        "as": "(খ) 20%"
      },
      "explanation": {
        "en": "To express one number as a percent of another, divide the part by the whole and multiply by 100: (36/180) x 100 = 20%.",
        "as": "এটা সংখ্যা আনটোৰ কিমান শতাংশ জানিবলৈ অংশক সম্পূৰ্ণৰে হৰণ কৰি 100 ৰে পূৰণ কৰা হয়: (36/180) x 100 = 20%।"
      }
    },
