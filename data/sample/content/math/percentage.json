      "q": {
        "en": "Find 20% of 250.",
        "as": "250 ৰ 20% নিৰ্ণয় কৰা।"
      },
      "options": {
        "en": [
          "(a) 50",
          "(b) 25",
          "(c) 40",
          "(d) 60"
        ],
        "as": [
          "(ক) ৫০",
          "(খ) ২৫",
          "(গ) ৪০",
          "(ঘ) ৬০"
        ]
      },
      "correct": "a",
      "a": {
        "en": [
          "Formula: Percentage = (Percent/100) × Number.",
          "Step 1: 20% of 250 = (20/100) × 250",
          "Step 2: = 5000/100 = 50",
          "Answer: (a) 50"
        ],
        "as": [
          "সূত্ৰ: শতাংশ = (শতাংশ/100) × সংখ্যা।",
          "পদক্ষেপ ১: 250 ৰ 20% = (20/100) × 250",
          "পদক্ষেপ ২: = 5000/100 = 50",
          "উত্তৰ: (ক) 50"
        ]
      }
