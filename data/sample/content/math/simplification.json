      "options": {
        "en": [
          "(a) 35",
          "(b) 33",
          "(c) 37",
          "(d) 31"
        ],
        "as": [
          "(ক) ৩৫",
          "(খ) ৩৩",
          "(গ) ৩৭",
          "(ঘ) ৩১"
        ]
      },
      "correct": "a",
      "a": {
        "en": [
          "Rule: Use BODMAS. First multiplication and division.",
          "Step 1: 8 × 3 = 24 → 25 − 12 + 24 − 2",
          "Step 2: 4 ÷ 2 = 2 → 25 − 12 + 24 − 2",
          "Step 3: Left to right: 25 − 12 = 13; 13 + 24 = 37; 37 − 2 = 35",
          "Answer: (a) 35"
        ],
        "as": [
          "নিয়ম: BODMAS ব্যৱহাৰ কৰা। প্ৰথমে গুণ আৰু ভাগ।",
          "পদক্ষেপ ১: 8 × 3 = 24 → 25 − 12 + 24 − 2",
          "পদক্ষেপ ২: 4 ÷ 2 = 2 → 25 − 12 + 24 − 2",
          "পদক্ষেপ ৩: বাওঁৰ পৰা সোঁলৈ: 25 − 12 = 13; 13 + 24 = 37; 37 − 2 = 35",
          "উত্তৰ: (ক) 35"
        ]
      }
