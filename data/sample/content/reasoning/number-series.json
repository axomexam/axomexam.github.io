    {
      "q": { "en": "Find the missing number: 3, 9, 27, 81, ?", "as": "অনুপস্থিত সংখ্যা উলিওৱা: 3, 9, 27, 81, ?" },
      "a": { "en": "243. (Each number is multiplied by 3)", "as": "243। (প্ৰতিটো সংখ্যা 3 ৰে পূৰণ হয়)" }
