# Long-lived caching for static assets.
# GitHub Pages ignores this file (it caps Cache-Control at 10 minutes).
# It is honored automatically if the site is served through Netlify or
# Cloudflare Pages, which sets the immutable one-year cache policy below.
# HTML is intentionally left on the default short TTL so content updates
# are picked up immediately; asset URLs are already versioned with ?v=.

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/app/*
  Cache-Control: public, max-age=31536000

/images/*
  Cache-Control: public, max-age=31536000

/assets/*
  Cache-Control: public, max-age=31536000

/favicon.ico
  Cache-Control: public, max-age=31536000

/favicon.svg
  Cache-Control: public, max-age=31536000

/apple-touch-icon.png
  Cache-Control: public, max-age=31536000

/android-chrome-192x192.png
  Cache-Control: public, max-age=31536000

/android-chrome-512x512.png
  Cache-Control: public, max-age=31536000
